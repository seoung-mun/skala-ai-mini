# finagent 환경 변수 — 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 값이 "여기에-키-입력"이면 키가 없는 것으로 처리합니다.

# ---- 데이터 (필수: 수집 스크립트 scripts/fetch_finlife.py) ----
# 금감원 금융상품한눈에 인증키 — https://finlife.fss.or.kr 회원가입 후 오픈API 인증키 신청
FINLIFE_API_KEY=여기에-키-입력

# ---- LLM ----
# ollama(로컬, 기본) | openai
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:8b
# 문맥 길이(KV 캐시 메모리). 16GB 노트북이면 8192 권장 — 넘는 프롬프트는 잘리지 않고 오류로 멈춥니다.
OLLAMA_NUM_CTX=8192
# LLM_BACKEND=openai일 때 필수. 사내/수업 프록시를 쓰면 OPENAI_BASE_URL도 채웁니다.
OPENAI_API_KEY=여기에-키-입력
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# ---- 관측 (LangSmith) — 켜면 질문 원문이 LangSmith로 전송됩니다 ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=여기에-키-입력
LANGSMITH_PROJECT=finagent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- v3 도구 (선택) ----
# Tavily 웹 검색 — 공시 밖 최신 정보(금리 인하 뉴스 등)를 '참고'로만 제공
TAVILY_API_KEY=여기에-키-입력
# 한국은행 ECOS — 기준금리·시장금리 조회 (https://ecos.bok.or.kr/api)
ECOS_API_KEY=여기에-키-입력

# ---- 실행 ----
# v1(베이스라인) | v2
SUPERVISOR_VERSION=v2
# 검색 상위 후보 리랭킹(bge-reranker-v2-m3, 메모리 ~0.4GB). 메모리가 빠듯하면 0
RERANK=1

# 멀티에이전트 방식 (ablation용): PLANNER=llm|rule, RAG_AGENT=react|fixed
PLANNER=llm
RAG_AGENT=react
# 추론(thinking) 모델: OPENAI_MODEL·AGENT_MODEL을 추론 모델(o4-mini, gpt-5-mini 등)로 두고 강도를 지정한다.
# 강도(minimal|low|medium|high)를 주면 temperature를 보내지 않는다. 비우면 일반 모델(temperature=0).
OPENAI_REASONING=
# 계획자·검색 에이전트 모델. 비우면 OPENAI_MODEL을 같이 쓴다
AGENT_MODEL=
AGENT_REASONING=
